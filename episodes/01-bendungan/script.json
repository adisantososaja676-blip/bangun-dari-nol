{
  "id": "01-bendungan",
  "title": "Nahan sungai cuma modal ranting, bisa nggak?",
  "notes": "Penanda teks: *kata* = kuning (istilah), !kata! = merah (kegagalan). Hapus penanda saat generate TTS.",
  "lines": [
    { "id": "hook",       "text": "Nahan sungai cuma modal *ranting*, bisa nggak?" },
    { "id": "intro",      "text": "Ini *Pak Bero*, berang-berang insinyur." },
    { "id": "tumpuk",     "text": "Pak Bero numpuk ranting dari tepi ke tepi." },
    { "id": "celah",      "text": "Masalahnya, ranting itu banyak *celahnya*." },
    { "id": "rembes",     "text": "Airnya !rembes! ke mana-mana." },
    { "id": "lumpur",     "text": "Jadi dia tambal pakai *lumpur*." },
    { "id": "naik",       "text": "Sekarang kedap, airnya mulai naik." },
    { "id": "tekanan",    "text": "Tapi makin dalam airnya, makin besar *tekanannya*." },
    { "id": "bawah",      "text": "Bagian paling bawah didorong paling keras," },
    { "id": "jebol",      "text": "sampai akhirnya !jebol!." },
    { "id": "urugan",     "text": "Solusinya, Pak Bero bikin *urugan tanah*:" },
    { "id": "trapesium",  "text": "bawahnya lebar, atasnya sempit." },
    { "id": "tubuh",      "text": "Ini namanya *tubuh bendungan*." },
    { "id": "tebal",      "text": "Bagian bawah paling tebal, pas buat nahan tekanan paling besar." },
    { "id": "hujan",      "text": "Masalahnya, pas hujan deras," },
    { "id": "meluap",     "text": "airnya naik sampai !meluap! lewat puncak." },
    { "id": "runtuh",     "text": "Tanahnya !tergerus!, bendungannya !runtuh!." },
    { "id": "overtop",    "text": "Ini namanya *overtopping*." },
    { "id": "gintung1",   "text": "Tahun 2009, tanggul tanah *Situ Gintung* jebol," },
    { "id": "gintung2",   "text": "dan sekitar seratus orang meninggal." },
    { "id": "gintung3",   "text": "Salah satu kajian menyebut saluran buang airnya kurang besar." },
    { "id": "jalur",      "text": "Jadi Pak Bero bikin jalur khusus buat buang air berlebih," },
    { "id": "beton",      "text": "dilapisi *beton* biar nggak tergerus." },
    { "id": "pelimpah",   "text": "Ini namanya *pelimpah*." },
    { "id": "rembes2",    "text": "Masalahnya lagi, air bisa !merembes! diam-diam lewat dalam tanah," },
    { "id": "butiran",    "text": "bawa butiran tanah sedikit demi sedikit," },
    { "id": "lorong",     "text": "sampai jadi !lorong!." },
    { "id": "piping",     "text": "Ini namanya *piping*." },
    { "id": "inti",       "text": "Solusinya, di tengah dipasang *inti kedap* dari tanah liat," },
    { "id": "filter",     "text": "plus *filter* pasir buat nahan butiran tanah." },
    { "id": "deras",      "text": "Sekarang hujan boleh deras," },
    { "id": "aman",       "text": "air lewat pelimpah, rembesan ketahan inti." },
    { "id": "berdiri",    "text": "Bendungannya *berdiri*." },
    { "id": "fakta1",     "text": "Oh iya, bendungan berang-berang terbesar di dunia" },
    { "id": "fakta2",     "text": "panjangnya hampir *800 meter*," },
    { "id": "fakta3",     "text": "sampai kelihatan dari *satelit*." },
    { "id": "outro",      "text": "Habis ini, Pak Bero bangun apa lagi ya?" }
  ]
}
